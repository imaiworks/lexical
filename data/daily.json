        { "en": "Likewise! Where are you from?", "ja": "こちらこそ！どちらのご出身ですか？" }
      ],
      "branches": [
        { "en": "Nice to meet you, too.", "ja": "こちらこそ、はじめまして", "type": "answer" },
        { "en": "What's your name?", "ja": "お名前は何ですか？", "type": "related" },
        { "en": "I'm ~. Please call me ~.", "ja": "〜です。〜と呼んでください", "type": "pattern" }
      ]
    },
    {
      "id": "self-intro",
      "en": "I'm from Japan.",
      "ja": "日本から来ました",
      "level": "beginner",
