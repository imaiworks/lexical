      "branches": [
        { "en": "I'm from Tokyo / Osaka.", "ja": "東京 / 大阪から来ました", "type": "variation" },
        { "en": "Where are you from?", "ja": "どこ出身ですか？", "type": "related" },
        { "en": "I've been here for ~ days.", "ja": "〜日間ここにいます", "type": "related" }
      ]
    },
