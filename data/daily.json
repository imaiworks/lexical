{
  "scene_id": "daily",
  "scene_label": "日常会話",
  "scene_icon": "💬",
  "mindset": {
    "flow": ["挨拶 → How are you? はセット", "自己紹介：名前・出身・仕事/目的", "天気・趣味などで雑談を広げる", "聞き取れなかったら素直に聞き返してOK"],
    "from_them": [
      { "en": "How are you?", "ja": "お元気ですか？" },
      { "en": "Where are you from?", "ja": "どちらのご出身ですか？" },
      { "en": "What brings you here?", "ja": "何でここに？" },
      { "en": "Sorry, could you say that again?", "ja": "もう一度言ってもらえますか？" }
    ],
    "from_you": [
      { "en": "I'm good, thanks! And you?", "ja": "元気です！あなたは？" },
      { "en": "I'm from Japan.", "ja": "日本から来ました" },
      { "en": "Nice weather today, isn't it?", "ja": "今日はいい天気ですね" },
      { "en": "Sorry, could you speak slowly?", "ja": "ゆっくり話してもらえますか？" }
    ]
  },
  "chunks": [
    {
      "id": "greeting-morning",
      "en": "Good morning! How are you?",
      "ja": "おはようございます！お元気ですか？",
      "level": "beginner",
      "nuance": "英語圏では挨拶に How are you? がセットになっていることが多い。",
      "google_translate_url": "https://translate.google.com/?sl=en&tl=ja&text=Good%20morning!%20How%20are%20you%3F&op=translate",
      "expected_responses": [
        { "en": "I'm good, thanks! And you?", "ja": "元気です、ありがとう！あなたは？" },
        { "en": "Not bad! Pretty busy lately.", "ja": "まあまあです！最近かなり忙しくて" },
        { "en": "Great, thanks for asking!", "ja": "最高です、聞いてくれてありがとう！" }
      ],
      "branches": [
        { "en": "I'm good, thanks! And you?", "ja": "元気です、ありがとう！あなたは？（定番の返し）", "type": "answer" },
        { "en": "Not bad.", "ja": "まあまあです", "type": "answer" },
        { "en": "Pretty good!", "ja": "かなりいい感じです", "type": "answer" },
        { "en": "Good evening / Good afternoon", "ja": "こんばんは / こんにちは", "type": "vocabulary" }
      ]
    },
    {
      "id": "nice-to-meet",
      "en": "Nice to meet you.",
      "ja": "はじめまして",
